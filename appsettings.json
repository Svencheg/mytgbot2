{
  "Application": {
    "Name": "MyTgBot2",
    "Version": "1.0.0",
    "Environment": "Production"
  },
  
  "Logging": {
    "MinimumLevel": "Information",
    "EnableFileLogging": true,
    "EnableConsoleLogging": true,
    "LogDirectory": "./Logs",
    "MaxLogFileSizeMB": 10,
    "MaxLogFileCount": 5
  },
  
  "Database": {
    "Type": "SQLite",
    "ConnectionString": "Data Source=./Data/botdata.db",
    "EnableAutoMigration": true
  },
  
  "AI": {
    "DefaultProvider": "Gemini",
    "EnableConversationHistory": true,
    "MaxHistoryMessages": 20,
    "RequestTimeoutSeconds": 30,
    "
MaxRetries": 3,
    
    "Gemini": {
      "Model": "gemini-3.0-flash",
      "ApiEndpoint": "https://generativelanguage.googleapis.com/v1beta",
      "Temperature": 0.7,
      "MaxOutputTokens": 2048,
      "UseFunctionCalling": true
    },
    
    "AlternativeProvider": {
      "Enabled": false,
      "Name": "CustomAI",
      "Endpoint": ""
    }
  },
  
  "Klipper": {
    "MoonrakerUrl": "http://localhost:7125",
    "WebcamUrl": "http://localhost:8080/?action=snapshot",
    "EnableStatusPolling": true,
    "StatusPollingIntervalSeconds": 10,
    "CommandTimeoutSeconds": 30
  },
  
  "PCControl": {
    "EnableWakeOnLan": true,
    "WolPort": 9,
    "SshConnectionTimeoutSeconds": 15,
    "EnableAutoReconnect": true,
    "MaxReconnectAttempts": 3
  },
  
  "Plugins": {
    "PluginsDirectory": "./Plugins",
    "EnableDynamicLoading": true,
    "AutoLoadOnStartup": true,
    "EnabledPlugins": [
      "KlipperPlugin",
      "PCControlPlugin"
    ]
  },
  
  "Security": {
    "EnableUserWhitelist": true,
    "EnableCommandRateLimit": true,
    "RateLimitMaxRequests": 30,
    "RateLimitWindowMinutes": 1
  },
  
  "Bot": {
    "CommandPrefix": "/",
    "EnableInlineMode": false,
    "MessageChunkSize": 4000,
    "PhotoCompressionQuality": 85
  }
}
